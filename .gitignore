# Dependencies
node_modules/
vendor/

# Build output
dist/
build/
out/
target/
.next/
.nuxt/
*.tsbuildinfo

# app/web's static export (output: 'export' in app/web/next.config.mjs),
# deployed to Firebase Hosting via `firebase deploy --only hosting:web` —
# already covered by the bare `out/` rule above, named explicitly since this
# is the directory firebase.json's hosting.public points at.
app/web/out/

# Go test/build artifacts
*.test
*.out

# Caches
.cache/
coverage/

# Environment / secrets
.env
.env.local
.env.*.local

# Logs
*.log

# Editor / OS
.idea/
.vscode/
*.swp
*~
.DS_Store

# Workspace tooling
tmp/
.archon/
.claude/
