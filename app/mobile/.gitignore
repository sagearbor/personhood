# Capacitor mobile shell — generated native projects and deps are NOT committed.
# `npx cap add android` / `npx cap add ios` regenerate them locally.

node_modules/
package-lock.json

# Native platform projects (generated by `cap add`; large + machine-specific).
/android/
/ios/

# Build artifacts
*.apk
*.aab
*.ipa
dist/

# Signing material — NEVER commit keystores or provisioning profiles.
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision

# Local env
.env
.env.local
