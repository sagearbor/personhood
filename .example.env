# Personhood — environment variables template.
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
#   cp .example.env .env.local
# Each variable is consumed by exactly one module; comments below list which.

# ---------- src/server (REST issuer) ----------

# Bind address for the HTTP server. Default: :8080
SERVER_ADDR=:8080

# Public URL the server is reachable at — used for magic-link callback URLs,
# webhook URLs, did:web resolution, and the `iss` field of issued credentials.
# In local dev this is typically http://localhost:8080; in production it's
# the Fly.io URL like https://personhood.fly.dev
SERVER_PUBLIC_URL=http://localhost:8080

# Ed25519 issuer signing key, base64-encoded (raw 32 bytes seed, NOT a PEM).
# Generate with: `go run ./src/server/cmd/gen-key`
# This is the private key the issuer uses to sign credentials. Treat like a password.
ISSUER_ED25519_SK_B64=

# CORS origin allowlist for the web app (comma-separated). Default: http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------- src/methods/email (SendGrid) ----------
# Build tag: `sendgrid`. Without this tag, the default LogSender is used.
# Free tier: 100 emails/day forever. Dashboard: https://app.sendgrid.com/

# API key from https://app.sendgrid.com/settings/api_keys
# Permissions required: Mail Send (Full Access). Restricted keys are recommended.
SENDGRID_API_KEY=

# Verified sender address. Either a Single Sender (easiest) verified at
# https://app.sendgrid.com/settings/sender_auth/senders, or any address on a
# domain you've authenticated at /settings/sender_auth/domains.
SENDGRID_FROM=noreply@yourdomain.com

# Optional display name shown to recipients.
SENDGRID_FROM_NAME=Personhood

# ---------- src/methods/sms (Twilio) ----------
# Build tag: `twilio`. Without this tag, the default LogSender is used.
# Trial gives ~$15 credit + a free verified number. Dashboard: https://console.twilio.com/

# Account SID + Auth Token from the Twilio console main page.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# A Twilio phone number you own (E.164 format, e.g. +15551234567).
# Trial accounts can only send to verified destination numbers — verify yours
# at https://console.twilio.com/us1/develop/phone-numbers/manage/verified
TWILIO_FROM=

# ---------- src/methods/government-id-liveness (Persona) ----------
# Persona Inquiries API. Dashboard: https://withpersona.com/dashboard
# Sandbox is free; no credit card needed.

# API key from https://withpersona.com/dashboard/api-keys.
# Sandbox keys start with `persona_sandbox_`; production with `persona_production_`.
PERSONA_API_KEY=

# Inquiry template ID — defines which document types + selfie liveness are required.
# Create one at https://withpersona.com/dashboard/inquiry-templates.
# For v0.1 use the default "Government ID + Selfie" template, ID starts with `itmpl_`.
PERSONA_TEMPLATE_ID=

# Webhook signing secret from https://withpersona.com/dashboard/webhooks.
# Used to verify HMAC on incoming inquiry.completed webhooks.
PERSONA_WEBHOOK_SECRET=

# Optional environment ID (Persona supports multiple sandbox envs per account).
PERSONA_ENVIRONMENT_ID=

# ---------- app/web (Next.js PWA) ----------
# These get prefixed with NEXT_PUBLIC_ so they're injected into the client bundle.

# Where the Personhood server is reachable from the browser.
NEXT_PUBLIC_PERSONHOOD_SERVER_URL=http://localhost:8080

# Persona's public template ID (same as PERSONA_TEMPLATE_ID above, but needed
# in the client to launch the hosted flow).
NEXT_PUBLIC_PERSONA_TEMPLATE_ID=

# Persona environment ID (sandbox env IDs start with `env_`).
NEXT_PUBLIC_PERSONA_ENVIRONMENT_ID=

# ---------- Fly.io (deploy target — read by `fly` CLI, not the app) ----------
# Set after `fly auth signup` + `fly launch`. The CLI manages most of these.
# App name appears in https://fly.io/dashboard
FLY_APP_NAME=personhood
