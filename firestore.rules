// firestore.rules — deny every client-SDK read and write.
//
// The issuer is the only thing that touches its Firestore collections, and it
// does so as a service account with an IAM-scoped OAuth2 token (see
// pkg/firestoreclient), which bypasses Security Rules entirely, the same way
// the Admin SDK does. In the emulator, pkg/firestoreclient authenticates as
// "Bearer owner" — the emulator's admin credential — for the same reason.
//
// firebase.json points the shared production (default) database at this
// file, so a bare `firebase deploy` from this repo publishes it. It must
// therefore be safe to publish: these collections hold email addresses and
// enrollment session state, and nothing outside the issuer should read them.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
