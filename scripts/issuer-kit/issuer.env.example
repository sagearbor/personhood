# Personhood issuer settings. ./up.sh writes the real file (issuer.env, mode
# 0600, gitignored) from this template and fills in the keys. Never commit it
# and never paste it anywhere: it holds the issuer's signing key.

# --- written by up.sh ---------------------------------------------------------
# The issuer's identity. Lose it and every credential you issued stops
# verifying; leak it and anyone can forge credentials in your name.
ISSUER_ED25519_SK_B64=
# Ties one email inbox to one person. NEVER change it once people enrolled:
# a new value forgets every binding, so every inbox could enroll again.
IDENTIFIER_HMAC_KEY=
# Bearer token for POST /v1/admin/revoke.
ADMIN_TOKEN=
# Your public address, e.g. https://issuer.example.org (no trailing slash).
SERVER_PUBLIC_URL=
# 1 behind Caddy, 0 when the issuer is reached directly (--local).
TRUSTED_PROXY_HOPS=1

# --- yours to set -------------------------------------------------------------
# Web apps allowed to call the issuer from a browser (comma separated).
CORS_ALLOWED_ORIGINS=https://openline-wallet.web.app
# Optional: only people with this code can enroll. Empty = open to everyone.
ENROLLMENT_INVITE_CODE=

# Email delivery — set ONE of these. Without either, sign-in links are only
# written to the issuer's log and nobody can enroll for real.
# Any SMTP account (a Gmail app password works, ~500 mails/day):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Or SendGrid:
SENDGRID_API_KEY=
SENDGRID_FROM=
SENDGRID_FROM_NAME=

# Rehearsal only: 1 shows the sign-in link to the client instead of emailing
# it, so ANYONE can enroll ANY address. Never leave it on for real use.
DEV_EXPOSE_CHALLENGE_SECRETS=
