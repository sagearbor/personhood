{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://personhood.protocol/schemas/personhood-credential.schema.json",
  "title": "PersonhoodCredential",
  "description": "A W3C Verifiable Credential issued by the Personhood framework asserting that the holder has completed one or more verification ceremonies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "@context",
    "id",
    "type",
    "issuer",
    "issuanceDate",
    "expirationDate",
    "credentialSubject"
  ],
  "properties": {
    "@context": {
      "description": "JSON-LD context array. The first entry must be the W3C VC context and the second must be the Personhood context.",
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "format": "uri" },
      "contains": { "const": "https://personhood.protocol/credentials/v1" }
    },
    "id": {
      "description": "Absolute URL that uniquely identifies this credential.",
      "type": "string",
      "format": "uri"
    },
    "type": {
      "description": "JSON-LD type array (typically ['VerifiableCredential', 'PersonhoodCredential']).",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "contains": { "const": "PersonhoodCredential" }
    },
    "issuer": {
      "description": "DID of the issuer that signed this credential.",
      "type": "string",
      "minLength": 1
    },
    "issuanceDate": {
      "description": "RFC3339 timestamp when the issuer produced the credential.",
      "type": "string",
      "format": "date-time"
    },
    "expirationDate": {
      "description": "RFC3339 timestamp when the credential expires. Must be after issuanceDate.",
      "type": "string",
      "format": "date-time"
    },
    "credentialSubject": {
      "description": "Holder-bound assertions.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "verifiedMethods"],
      "properties": {
        "id": {
          "description": "Holder DID.",
          "type": "string",
          "minLength": 1
        },
        "verifiedMethods": {
          "description": "Methods the issuer successfully verified for this holder.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/VerifiedMethod" }
        },
        "anchorMethodId": {
          "description": "Identifier of the verified method designated as the anchor. Must appear in verifiedMethods.",
          "type": "string"
        },
        "nullifierBinding": {
          "$ref": "#/definitions/NullifierBinding"
        }
      }
    },
    "credentialStatus": {
      "$ref": "#/definitions/CredentialStatus"
    },
    "proof": {
      "$ref": "#/definitions/Proof"
    }
  },
  "definitions": {
    "VerifiedMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "strength",
        "verified_at",
        "freshness_lifetime",
        "attestation_digest"
      ],
      "properties": {
        "method_id": {
          "description": "Method plugin identifier.",
          "type": "string",
          "minLength": 1
        },
        "strength": {
          "description": "Method strength frozen at issuance time, in [0, 100].",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "verified_at": {
          "description": "RFC3339 timestamp when the ceremony completed.",
          "type": "string",
          "format": "date-time"
        },
        "freshness_lifetime": {
          "description": "Per-method freshness window in nanoseconds (Go time.Duration).",
          "type": "integer",
          "minimum": 0
        },
        "attestation_digest": {
          "description": "Hex-encoded SHA-256 digest of the underlying attestation evidence.",
          "type": "string",
          "pattern": "^[0-9a-fA-F]+$"
        }
      }
    },
    "NullifierBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitment", "curve", "scheme"],
      "properties": {
        "commitment": {
          "description": "Hex-encoded Pedersen commitment to the holder secret plus an issuer salt.",
          "type": "string",
          "pattern": "^[0-9a-fA-F]+$"
        },
        "curve": {
          "description": "Elliptic curve name (e.g. 'bn254').",
          "type": "string",
          "minLength": 1
        },
        "scheme": {
          "description": "Commitment scheme identifier (e.g. 'pedersen-v1').",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "CredentialStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "statusPurpose", "statusListIndex", "statusListCredential"],
      "properties": {
        "id": { "type": "string", "format": "uri" },
        "type": { "type": "string", "const": "StatusList2021Entry" },
        "statusPurpose": { "type": "string", "const": "revocation" },
        "statusListIndex": { "type": "integer", "minimum": 0 },
        "statusListCredential": { "type": "string", "format": "uri" }
      }
    },
    "Proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "created", "proofPurpose", "verificationMethod", "proofValue"],
      "properties": {
        "type": { "type": "string", "const": "Ed25519Signature2020" },
        "created": { "type": "string", "format": "date-time" },
        "proofPurpose": { "type": "string", "const": "assertionMethod" },
        "verificationMethod": { "type": "string", "minLength": 1 },
        "proofValue": { "type": "string", "minLength": 1 }
      }
    }
  }
}
